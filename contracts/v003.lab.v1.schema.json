            "$ref": "#/$defs/contact"
          }
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "fork_id": {
          "type": "string",
          "pattern": "^V003-Y(095|096|097|098|099|100|101|102|103|104|105)$"
        }
      },
      "required": [
        "authority",
        "scenario",
        "states",
        "contacts",
        "manifest_sha256",
        "fork_id"
      ]
