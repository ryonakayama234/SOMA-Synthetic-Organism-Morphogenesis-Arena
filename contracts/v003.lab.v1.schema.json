        },
        "pre_vx_a_mps": {
          "type": "number",
          "description": "Finite SI JSON number; source-independent semantic verifier required"
        },
        "pre_vy_a_mps": {
          "type": "number",
          "description": "Finite SI JSON number; source-independent semantic verifier required"
        },
        "pre_vx_b_mps": {
          "type": "number",
          "description": "Finite SI JSON number; source-independent semantic verifier required"
        },
        "pre_vy_b_mps": {
          "type": "number",
          "description": "Finite SI JSON number; source-independent semantic verifier required"
        },
        "post_vx_a_mps": {
          "type": "number",
          "description": "Finite SI JSON number; source-independent semantic verifier required"
        },
        "post_vy_a_mps": {
          "type": "number",
