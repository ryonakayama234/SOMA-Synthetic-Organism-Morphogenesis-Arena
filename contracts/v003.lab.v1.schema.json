    "original": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authority": {
          "const": "original_frozen_f022"
        },
        "scenario": {
          "$ref": "#/$defs/scenario"
        },
        "states": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {
            "$ref": "#/$defs/state"
          }
        },
        "contacts": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/contact"
          }
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "authority",
        "scenario",
        "states",
        "contacts",
        "manifest_sha256"
      ]
    },
    "derived": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authority": {
          "const": "derived_v003_independently_verified"
        },
        "scenario": {
          "$ref": "#/$defs/scenario"
        },
        "states": {
