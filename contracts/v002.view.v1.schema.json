{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ryonakayama234/SOMA-Synthetic-Organism-Morphogenesis-Arena/blob/design/V002-counterfactual-observatory-20261026/contracts/v002.view.v1.schema.json",
  "title": "V002 view-only versioned record contract — DRAFT until independent review and immutable design freeze",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "v002.view.v1"
    },
    "status": {
      "const": "verified_projection"
    },
    "contract_id": {
      "const": "V002"
    },
    "worlds": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "oneOf": [
        {
          "prefixItems": [
            {
              "$ref": "#/$defs/F022World"
            },
            {
              "$ref": "#/$defs/F022World"
            }
          ],
          "items": false
        },
        {
          "prefixItems": [
            {
              "$ref": "#/$defs/F023World"
            },
            {
              "$ref": "#/$defs/F023World"
            }
          ],
          "items": false
        }
      ]
    },
    "joint_sample_times_s": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "number"
      },
      "uniqueItems": true
    },
    "timeline": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TimelinePointer"
      }
    },
    "parameter_diff": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/InputDiff"
      }
    },
    "pair_inference": {
      "type": "string",
      "enum": [
        "identical",
        "single_field",
        "multi_field"
      ]
    },
    "evidence": {
      "type": "object",
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/VerifiedSource"
          }
        },
        "archive_semantics_oracle": {
          "const": "pass"
        },
        "view_projection_oracle": {
          "const": "pass"
        }
      },
      "required": [
        "sources",
        "archive_semantics_oracle",
        "view_projection_oracle"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "status",
    "contract_id",
    "worlds",
    "joint_sample_times_s",
    "timeline",
    "parameter_diff",
    "pair_inference",
    "evidence"
